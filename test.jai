#insert "code";
#insert var;
#insert call();
#insert cast(string, value);
#insert call().(string);
#insert #run call();
#insert #run,stallable call();
#insert #run () -> string { return "string"; };
#insert #run () -> Code { return #code var; };
#insert -> Code { return #code var; };
#insert -> string { return "string"; };
